{
  "name": "devops-capstone",
  "version": "1.0.0",
  "description": "Complete DevOps capstone project with microservices architecture",
  "main": "index.js",
  "scripts": {
    "install:frontend": "cd services/frontend && npm install",
    "install:backend": "cd services/backend && npm install",
    "install:all": "npm run install:frontend && npm run install:backend",
    "start:frontend": "cd services/frontend && npm start",
    "start:backend": "cd services/backend && npm run dev",
    "build:frontend": "cd services/frontend && npm run build",
    "build:backend": "cd services/backend && npm run build",
    "build:all": "npm run build:frontend && npm run build:backend",
    "test:frontend": "cd services/frontend && npm test",
    "test:backend": "cd services/backend && npm test",
    "test:all": "npm run test:frontend && npm run test:backend",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "k8s:deploy": "chmod +x ./ci-cd/scripts/deploy.sh && ./ci-cd/scripts/deploy.sh --environment staging",
    "k8s:health": "chmod +x ./ci-cd/scripts/health-check.sh && ./ci-cd/scripts/health-check.sh --environment staging",
    "k8s:cleanup": "chmod +x ./ci-cd/scripts/cleanup.sh && ./ci-cd/scripts/cleanup.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/capstone-01.git"
  },
  "keywords": [
    "devops",
    "kubernetes",
    "docker",
    "helm",
    "jenkins",
    "prometheus",
    "grafana",
    "mongodb",
    "nodejs",
    "react",
    "typescript",
    "ci-cd",
    "microservices"
  ],
  "author": "DevOps Engineer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-username/capstone-01/issues"
  },
  "homepage": "https://github.com/your-username/capstone-01#readme",
  "workspaces": [
    "services/frontend",
    "services/backend"
  ]
}